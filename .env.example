APP_NAME=RotaHub
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL
# Project Settings -> Database -> Connection string (URI)
# Troque o prefixo "postgresql://" por "postgresql+psycopg://"
# Senhas com caracteres especiais devem ser URL-encoded
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Pool de conexoes (ignorado quando usa o pooler do Supabase na porta 6543)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
