APP_NAME=RotaHub
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rotahub-front.vercel.app

# Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# JWT
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin inicial (criado automaticamente se a tabela users estiver vazia)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@rotahub.app
ADMIN_PASSWORD=Admin@123

# Roteirização (OSRM + Nominatim). Futuro: OpenRouteService.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_USER_AGENT=RotaHub/0.1 (contato@rotahub.app)
